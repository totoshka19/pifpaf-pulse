{
  "name": "pifpaf-pulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "node --env-file=.env.local scripts/db-check.mjs",
    "db:verify": "node --env-file=.env.local scripts/db-verify-constraints.mjs",
    "test:db": "vitest run --config vitest.integration.mts",
    "e2e:reels": "node scripts/e2e-reels.mjs",
    "verify:live": "node scripts/verify-live-apify.mjs",
    "e2e:thumbnails": "node scripts/e2e-thumbnails.mjs",
    "e2e:feed": "node scripts/e2e-feed.mjs",
    "verify:prod": "node --env-file=.env.local scripts/verify-prod.mjs",
    "thumbs:backfill": "tsx --env-file=.env.local scripts/backfill-thumbnails.mts",
    "seed:demo": "tsx --env-file=.env.local scripts/seed-demo-history.mts",
    "e2e:dashboard": "node scripts/e2e-dashboard.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "next": "16.3.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
