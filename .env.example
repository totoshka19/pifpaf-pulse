# Скопируй в .env.local и заполни. Реальные значения в репозиторий не коммитим.

# --- База ---
# Neon отдаёт строку вида:
#   postgresql://neondb_owner:ПАРОЛЬ@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# ⚠️ ОБЯЗАТЕЛЬНО убрать "&channel_binding=require".
# Это параметр libpq, а не настройка сервера. postgres.js не знает такой опции
# и переправляет её в стартовый пакет как runtime-параметр PostgreSQL, из-за чего
# соединение обрывается с FATAL: unrecognized configuration parameter.
# "sslmode=require" оставить — его драйвер обрабатывает правильно.

# Для приложения — строка С пулером (хост содержит "-pooler").
# Пулер обязателен на serverless: каждый вызов функции открывает своё соединение.
DATABASE_URL=

# Для миграций — строка БЕЗ пулера (тот же хост, но без "-pooler").
# drizzle-kit берёт advisory-локи и гоняет многошаговый DDL, которому нужна
# стабильная сессия; PgBouncer в transaction-режиме её не гарантирует.
DATABASE_URL_UNPOOLED=

# --- Apify ---
# ВНИМАНИЕ: только серверная переменная. Никогда не NEXT_PUBLIC_*.
APIFY_TOKEN=
APIFY_ACTOR_ID=apify~instagram-scraper

# Предохранитель бюджета: реальный потолок free tier ≈1850 результатов в месяц
# ($5 кредитов / $2.70 за 1000). Держим ниже, чтобы остался буфер. См. PLAN.md §7.
APIFY_MONTHLY_CAP=1500

# 1 — работать на фикстурах из fixtures/apify/, не тратить кредиты.
# Значение по умолчанию для разработки — именно 1.
APIFY_MOCK=1

# --- Секреты ---
# Минимум 32 символа. Сгенерировать: openssl rand -base64 48
JWT_SECRET=
# Общий секрет для внешнего планировщика (cron-job.org), заголовок X-Cron-Secret
CRON_SECRET=

# --- Приложение ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
